---
import { actions } from 'astro:actions';
import { eq } from 'drizzle-orm';
import Admin from '../../../layouts/Admin.astro';
import { db, schema } from '../../../db/client';

const result = Astro.getActionResult(actions.saveCategory);
if (result && !result.error) return Astro.redirect('/admin/categorias');
const isNew = Astro.params.id === 'nueva';
const c = isNew ? undefined : await db.query.categories.findFirst({ where: eq(schema.categories.id, Number(Astro.params.id)) });
if (!isNew && !c) return new Response(null, { status: 404 });
---
<Admin title={isNew ? 'Nueva categoría' : `Editar ${c!.name}`}>
  <h1 class="text-3xl">{isNew ? 'Nueva categoría' : `Editar ${c!.name}`}</h1>
  {result?.error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{result.error.message}</p>}
  <form method="POST" action={actions.saveCategory} enctype="multipart/form-data" class="mt-6 grid max-w-3xl gap-5 rounded-2xl bg-white p-6 ring-1 ring-black/5">
    {c && <input type="hidden" name="id" value={c.id} />}
    <input type="hidden" name="imageUrl" value={c?.imageUrl ?? ''} />
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="label">Nombre</label><input name="name" class="input" required value={c?.name} placeholder="Cosméticos" /></div>
      <div><label class="label">Slug (URL)</label><input name="slug" class="input" value={c?.slug} placeholder="se genera del nombre" /></div>
    </div>
    <div><label class="label">Descripción</label><textarea name="description" class="input" rows="3">{c?.description}</textarea></div>
    <div><label class="label">Imagen (opcional; si no, se usa la foto de un producto)</label><input name="image" type="file" accept="image/*" class="input" />{c?.imageUrl && <img src={c.imageUrl} alt="" class="mt-2 h-16 rounded object-cover" />}</div>
    <div class="flex items-center gap-6">
      <div><label class="label">Orden</label><input name="sort" type="number" class="input w-24" value={c?.sort ?? 0} /></div>
      <label class="mt-5 flex items-center gap-2 text-sm"><input name="active" type="checkbox" checked={c?.active ?? true} /> Visible en el sitio</label>
    </div>
    <div class="flex gap-3"><button class="btn-primary">Guardar</button><a href="/admin/categorias" class="btn ring-1 ring-black/10">Cancelar</a></div>
  </form>
</Admin>
