---
import Site from '../layouts/Site.astro';
---
<Site title="Página no encontrada" description="La página que buscas no existe.">
  <section class="container-x py-[clamp(96px,14vw,200px)]">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 max-w-[16ch] text-[clamp(2.4rem,5.4vw,4.4rem)] leading-[1.05]">Esa página no existe</h1>
    <p class="mt-6 max-w-[48ch] text-fg/72">O el producto ya no está disponible.</p>
    <a href="/productos" class="btn-light mt-10">Ver catálogo</a>
  </section>
</Site>
