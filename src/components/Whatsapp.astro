---
/* WhatsApp entry: floating pill on desktop, sticky bar on mobile. The number comes from /admin settings (env fallback). */
import { getSettings } from '../db/queries';
import { SITE } from '../config/site';
import { waLink } from '../lib/format';
const s = await getSettings();
const wa = waLink(`Hola ${SITE.name}, quiero más información.`, s.whatsapp);
const icon = 'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03 0 1.2.87 2.35.99 2.52.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z';
---
{s.whatsapp && (
  <Fragment>
    <a href={wa} target="_blank" rel="noopener" class="rise fixed bottom-6 right-6 z-40 hidden items-center gap-2.5 rounded-[3px] border border-accent/50 bg-raised/90 px-4.5 py-3 text-[13px] tracking-[0.06em] text-accent backdrop-blur-md transition-all duration-500 ease-out-expo hover:bg-accent hover:text-page md:flex" style="--d: 1.1s">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon} /></svg>
      WhatsApp
    </a>
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto] gap-2.5 border-t border-muted/25 bg-deep/95 px-5 pb-[calc(14px+env(safe-area-inset-bottom))] pt-3.5 backdrop-blur-xl md:hidden">
      <button type="button" class="btn-light !min-h-12" data-cart-open>Ver mi pedido</button>
      <a href={wa} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" class="flex min-h-12 min-w-[52px] items-center justify-center rounded-[3px] border border-accent/60 text-accent">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon} /></svg>
      </a>
    </div>
    <div class="h-20 md:hidden" aria-hidden="true"></div>
  </Fragment>
)}
