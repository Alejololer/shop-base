---
import { actions } from 'astro:actions';
import { desc } from 'drizzle-orm';
import Admin from '../../layouts/Admin.astro';
import { db, schema } from '../../db/client';

const logout = Astro.getActionResult(actions.logout);
if (logout && !logout.error) return Astro.redirect('/admin/login');
const rows = await db.select().from(schema.leads).orderBy(desc(schema.leads.createdAt)).limit(200);
const fmt = new Intl.DateTimeFormat('es-EC', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Guayaquil' });
---
<Admin title="Leads">
  <div class="flex items-center justify-between"><h1 class="text-3xl">Leads ({rows.length})</h1><a href="/admin/leads.csv" class="btn-primary !py-2 text-xs">Exportar CSV</a></div>
  <div class="mt-6 overflow-x-auto rounded-2xl bg-white ring-1 ring-black/5">
    <table class="w-full text-sm">
      <thead class="bg-surface text-left text-xs uppercase tracking-wider text-slate"><tr><th class="p-3">Fecha</th><th class="p-3">Nombre</th><th class="p-3">Teléfono</th><th class="p-3">Ciudad</th><th class="p-3">Producto</th><th class="p-3">Mensaje</th><th class="p-3">Origen</th><th class="p-3"></th></tr></thead>
      <tbody>
        {rows.length === 0 && <tr><td colspan="8" class="p-6 text-center text-slate">Sin leads todavía.</td></tr>}
        {rows.map((l) => (
          <tr class="border-t border-black/5 align-top">
            <td class="whitespace-nowrap p-3 text-slate">{fmt.format(l.createdAt)}</td>
            <td class="p-3 font-medium">{l.name}{l.email && <><br /><span class="text-xs text-slate">{l.email}</span></>}</td>
            <td class="p-3"><a href={`https://wa.me/${l.phone.replace(/\D/g, '')}`} target="_blank" class="text-navy underline">{l.phone}</a></td>
            <td class="p-3">{l.city}</td><td class="p-3">{l.product}</td>
            <td class="max-w-xs p-3 text-slate">{l.message}</td>
            <td class="p-3 text-xs text-slate">{l.source}</td>
            <td class="p-3"><form method="POST" action={actions.deleteLead} onsubmit="return confirm('¿Eliminar lead?')"><input type="hidden" name="id" value={l.id} /><button class="text-xs text-red-600 hover:underline">Eliminar</button></form></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
