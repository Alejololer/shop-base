---
import { actions } from 'astro:actions';
import { eq } from 'drizzle-orm';
import Admin from '../../../layouts/Admin.astro';
import { db, schema } from '../../../db/client';

const result = Astro.getActionResult(actions.saveBrand);
if (result && !result.error) return Astro.redirect('/admin/marcas');
const isNew = Astro.params.id === 'nueva';
const b = isNew ? undefined : await db.query.brands.findFirst({ where: eq(schema.brands.id, Number(Astro.params.id)) });
if (!isNew && !b) return new Response(null, { status: 404 });
---
<Admin title={isNew ? 'Nueva marca' : `Editar ${b!.name}`}>
  <h1 class="text-3xl">{isNew ? 'Nueva marca' : `Editar ${b!.name}`}</h1>
  {result?.error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{result.error.message}</p>}
  <form method="POST" action={actions.saveBrand} enctype="multipart/form-data" class="mt-6 grid max-w-3xl gap-5 rounded-2xl bg-white p-6 ring-1 ring-black/5">
    {b && <input type="hidden" name="id" value={b.id} />}
    <input type="hidden" name="logoUrl" value={b?.logoUrl ?? ''} /><input type="hidden" name="heroUrl" value={b?.heroUrl ?? ''} />
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="label">Nombre</label><input name="name" class="input" required value={b?.name} /></div>
      <div><label class="label">Slug (URL)</label><input name="slug" class="input" value={b?.slug} placeholder="se genera del nombre" /></div>
    </div>
    <div><label class="label">Tagline</label><input name="tagline" class="input" value={b?.tagline} /></div>
    <div><label class="label">Descripción</label><textarea name="description" class="input" rows="4">{b?.description}</textarea></div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="label">Logo (PNG/SVG, fondo transparente)</label><input name="logo" type="file" accept="image/*" class="input" />{b?.logoUrl && <img src={b.logoUrl} alt="" class="mt-2 h-10 rounded bg-surface p-1" />}</div>
      <div><label class="label">Imagen hero (1600×1000)</label><input name="hero" type="file" accept="image/*" class="input" />{b?.heroUrl && <img src={b.heroUrl} alt="" class="mt-2 h-16 rounded object-cover" />}</div>
    </div>
    <div class="flex items-center gap-6">
      <div><label class="label">Orden</label><input name="sort" type="number" class="input w-24" value={b?.sort ?? 0} /></div>
      <label class="mt-5 flex items-center gap-2 text-sm"><input name="active" type="checkbox" checked={b?.active ?? true} /> Visible en el sitio</label>
    </div>
    <div class="flex gap-3"><button class="btn-primary">Guardar</button><a href="/admin/marcas" class="btn ring-1 ring-black/10">Cancelar</a></div>
  </form>
</Admin>
