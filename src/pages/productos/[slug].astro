---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import { activeProducts, getSettings, productBySlug } from '../../db/queries';
import { SITE } from '../../config/site';
import { priceLabel, usd, waLink } from '../../lib/format';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';
import { fill, hasVariants, soldOut, variantOptions } from '../../lib/shop';

const row = await productBySlug(Astro.params.slug!);
if (!row) return new Response(null, { status: 404 });
const { product: p, brand: b, category: c, variants } = row;
const settings = await getSettings();
const images = [p.heroUrl, ...p.gallery].filter((u, i, a): u is string => !!u && a.indexOf(u) === i);
const related = (await activeProducts({ category: c?.slug })).filter((r) => r.product.id !== p.id).slice(0, 4);
const labels: [string | null, string | null] = [p.option1Label, p.option2Label];
const out = soldOut(variants);
const firstInStock = variants.find((v) => v.stock > 0);
// Snapshot of what the cart needs; the chosen variant overrides variantId/options/max on submit.
const cartItem = { productId: p.id, slug: p.slug, name: p.name, price: p.price, image: images[0] ?? null, variantId: null, options: [], max: null };
const ask = fill(settings.productTemplate || 'Hola {store}, me interesa "{name}". ¿Está disponible?', { store: SITE.name, name: p.name });
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Productos', path: '/productos' },
  ...(c ? [{ name: c.name, path: `/productos?categoria=${c.slug}` }] : []),
  { name: p.name, path: `/productos/${p.slug}` },
];
const onSale = p.compareAt != null && p.price != null && p.compareAt > p.price;
---
<Site
  title={`${p.name}${b ? ` ${b.name}` : ''} · ${priceLabel(p.price)}`}
  description={p.shortDesc ?? `${p.name} en ${SITE.name}. ${p.price != null ? `${usd(p.price)}.` : ''} Pide por WhatsApp.`}
  image={images[0]}
  type="product"
  jsonLd={[productJsonLd(p, b, c, variants), breadcrumbJsonLd(crumbs)]}
>
  <section class="container-x grid gap-12 pb-[clamp(64px,9vw,120px)] pt-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <!-- Gallery: first photo large, the rest in a grid. ponytail: no carousel JS; add one if stores upload 10+ photos. -->
    <div class="grid gap-3 sm:grid-cols-2">
      {images.length === 0 && <div class="flex aspect-square items-center justify-center bg-raised-2 text-sm uppercase tracking-[0.2em] text-muted sm:col-span-2">Sin foto</div>}
      {images.map((src, i) => (
        <div class:list={['aspect-square overflow-hidden bg-raised-2', i === 0 && 'sm:col-span-2']}>
          <img src={src} alt={i === 0 ? p.name : `${p.name}, foto ${i + 1}`} width="1000" height="1000" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" class="h-full w-full object-cover" />
        </div>
      ))}
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <nav aria-label="Migas" class="text-xs tracking-[0.1em] text-fg/50">
        <a href="/productos" class="hover:text-accent">Productos</a>
        {c && <span> / <a href={`/productos?categoria=${c.slug}`} class="hover:text-accent">{c.name}</a></span>}
      </nav>
      {b && <a href={`/marcas/${b.slug}`} class="eyebrow mt-6 block !text-accent hover:underline">{b.name}</a>}
      <h1 class="mt-3 text-[clamp(2rem,4vw,3rem)] leading-[1.08]">{p.name}</h1>
      <p class="mt-5 flex items-baseline gap-3">
        <span class="display text-3xl">{priceLabel(p.price)}</span>
        {onSale && <s class="text-fg/50">{usd(p.compareAt)}</s>}
      </p>
      {p.shortDesc && <p class="mt-5 max-w-[52ch] text-fg/75">{p.shortDesc}</p>}

      <form class="mt-8" data-add={JSON.stringify(cartItem)}>
        {hasVariants(variants) && (
          <fieldset>
            <legend class="field-label">{labels.filter(Boolean).join(' / ') || 'Opción'}</legend>
            <!-- ponytail: one pill per variant, not one picker per axis. Fine up to ~20 variants; beyond that split into two selects. -->
            <div class="mt-2 flex flex-wrap gap-2">
              {variants.map((v) => {
                const text = [v.option1, v.option2].filter(Boolean).join(' · ') || v.sku || `Opción ${v.id}`;
                return (
                  <label class:list={['border px-4 py-2 text-sm transition-colors has-[:checked]:border-fg has-[:checked]:bg-fg has-[:checked]:text-page has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent/60', v.stock > 0 ? 'cursor-pointer border-muted/40 hover:border-fg' : 'cursor-not-allowed border-muted/20 text-fg/35 line-through']}>
                    <input type="radio" name="variant" value={v.id} class="sr-only" required disabled={v.stock <= 0} checked={v.id === firstInStock?.id} data-options={JSON.stringify(variantOptions(labels, v))} data-stock={v.stock} />
                    {text}
                  </label>
                );
              })}
            </div>
          </fieldset>
        )}
        <div class="mt-6 flex gap-3">
          <label class="sr-only" for="qty">Cantidad</label>
          <input id="qty" name="qty" type="number" min="1" value="1" inputmode="numeric" class="w-20 border border-muted/40 bg-transparent px-3 text-center" disabled={out} />
          <button class="btn-light flex-1 disabled:cursor-not-allowed disabled:opacity-50" disabled={out}>{out ? 'Agotado' : 'Agregar al pedido'}</button>
        </div>
      </form>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <a href={waLink(ask, settings.whatsapp)} target="_blank" rel="noopener" class="btn-ghost w-full">Preguntar por WhatsApp</a>
        <button type="button" class="btn-ghost w-full" data-lead={p.name}>Déjanos tus datos</button>
      </div>

      {p.description && <div class="hairline mt-10 whitespace-pre-line pt-8 text-fg/78">{p.description}</div>}
      {p.specs.length > 0 && (
        <dl class="mt-8">
          {p.specs.map((s) => <div class="flex justify-between gap-6 border-b border-muted/15 py-3.5 text-[15px]"><dt class="text-fg/55">{s.label}</dt><dd class="text-right">{s.value}</dd></div>)}
        </dl>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="hairline bg-deep">
      <div class="container-x section-y">
        <p class="reveal eyebrow">También te puede gustar</p>
        <div class="stagger mt-12 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">{related.map((r) => <ProductCard {...r} />)}</div>
      </div>
    </section>
  )}
</Site>
