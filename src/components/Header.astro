---
import { SITE } from '../config/site';
const nav = [
  ['/productos', 'Productos'],
  ['/marcas', SITE.taxonomy.brand.plural],
  ['/nosotros', 'Nosotros'],
  ['/contacto', 'Contacto'],
];
const path = Astro.url.pathname;
const active = (h: string) => path.startsWith(h);
const bag = 'M6 7h12l-1 13H7L6 7Zm3 0V6a3 3 0 0 1 6 0v1';
---
<header class="hdr sticky top-0 z-40 border-b border-muted/15 bg-deep/92 text-fg backdrop-blur-xl">
  <div class="progress pointer-events-none absolute inset-x-0 -bottom-px h-px bg-accent" aria-hidden="true"></div>
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <!-- ponytail: text wordmark until the store has a logo; swap for <img src="/logo.svg"> -->
    <a href="/" class="display shrink-0 text-2xl tracking-[0.04em]" aria-label={`${SITE.name}, inicio`}>{SITE.name}</a>
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {nav.map(([href, label]) => (
        <a href={href} class:list={['nav-link px-3.5 py-2 text-[13px] tracking-[0.06em] transition-colors duration-500', active(href) ? 'text-accent' : 'text-fg/65 hover:text-fg']} aria-current={active(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <button type="button" class="relative flex h-10 w-10 items-center justify-center text-fg/80 transition-colors hover:text-accent" aria-label="Abrir carrito" data-cart-open>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d={bag} /></svg>
        <span class="num absolute -right-0.5 -top-0.5 flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-accent px-1 text-[11px] text-page" data-cart-count hidden>0</span>
      </button>
      <details class="group lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center text-fg/80 transition-colors duration-500 group-open:text-accent" aria-label="Menú">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path class="transition-transform duration-500 ease-out-expo group-open:translate-y-[5px] group-open:rotate-45" style="transform-origin: 12px 7px" d="M4 7h16" />
            <path class="transition-opacity duration-300 group-open:opacity-0" d="M4 12h16" />
            <path class="transition-transform duration-500 ease-out-expo group-open:-translate-y-[5px] group-open:-rotate-45" style="transform-origin: 12px 17px" d="M4 17h16" />
          </svg>
        </summary>
        <div class="menu fixed inset-x-0 top-[72px] max-h-[calc(100dvh-72px)] overflow-y-auto border-t border-muted/15 bg-deep px-5 pb-10 pt-2 sm:px-6">
          {nav.map(([href, label]) => (
            <a href={href} class:list={['display flex items-center justify-between border-b border-muted/15 py-4 text-2xl transition-colors duration-500', active(href) ? 'text-accent' : 'text-fg hover:text-accent']} aria-current={active(href) ? 'page' : undefined}>
              {label}<span class="text-base text-accent/70" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
