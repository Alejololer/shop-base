---
import { actions } from 'astro:actions';
/* Global "Consultar" dialog. Any element with data-lead="Product name" opens it with the product prefilled. */
---
<dialog id="lead" class="m-auto w-[min(92vw,32rem)] border border-accent/35 bg-raised p-0 text-fg backdrop:backdrop-blur-sm">
  <form method="POST" action={actions.lead} class="p-6 sm:p-10">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow !text-accent">Consulta</p>
        <h2 class="mt-2 text-3xl">Te respondemos hoy</h2>
      </div>
      <button type="button" class="p-2 text-fg/60 hover:text-accent" aria-label="Cerrar" data-close>✕</button>
    </div>
    <input type="hidden" name="source" value={Astro.url.pathname} />
    <div class="mt-8 grid gap-6">
      <div><label class="field-label" for="ld-product">Producto de interés</label><input id="ld-product" name="product" class="field" placeholder="Ej. Labial mate, polo talla M" /></div>
      <div><label class="field-label" for="ld-name">Nombre</label><input id="ld-name" name="name" class="field" required autocomplete="name" /></div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div><label class="field-label" for="ld-phone">WhatsApp / teléfono</label><input id="ld-phone" name="phone" class="field" required inputmode="tel" autocomplete="tel" /></div>
        <div><label class="field-label" for="ld-city">Ciudad</label><input id="ld-city" name="city" class="field" autocomplete="address-level2" /></div>
      </div>
      <div><label class="field-label" for="ld-msg">Mensaje</label><textarea id="ld-msg" name="message" class="field" rows="2"></textarea></div>
    </div>
    <button class="btn-light mt-8 w-full">Enviar consulta</button>
    <p class="mt-4 text-center text-[13px] text-fg/50">Respondemos por WhatsApp en horario de atención.</p>
  </form>
</dialog>
<script>
  function bind() {
    const dlg = document.getElementById('lead') as HTMLDialogElement | null;
    if (!dlg) return;
    document.querySelectorAll<HTMLElement>('[data-lead]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        (dlg.querySelector('[name=product]') as HTMLInputElement).value = el.dataset.lead ?? '';
        dlg.showModal();
      });
    });
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
